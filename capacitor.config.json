{
  "appId": "com.inkstall.fourkal",
  "appName": "4kal",
  "webDir": "dist",
  "server": {
    "url": "https://www.4kal.com/",
    "cleartext": true
  },
  "ios": {
    "contentInset": "never",
    "allowsLinkPreview": false,
    "scrollEnabled": true,
    "backgroundColor": "#FFFFFF",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#FFFFFFFF",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}